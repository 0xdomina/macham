{
  "name": "macham",
  "version": "0.1.0",
  "description": "Store-agnostic AI SDK for e-commerce. Any store in, assistance out.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:loader": "esbuild src/loader.ts --bundle --minify --format=iife --global-name=Macham --outfile=dist-loader/macham.js --target=es2020",
    "build:ext": "esbuild src/extension-content.ts --bundle --minify --format=iife --outfile=extension/content.js --target=chrome120",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"./test/*.mjs\"",
    "smoke": "npm run build && node ./smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@rialo/ts-cdk": "^0.18.1"
  }
}
