# Copy to .env (never committed). Server-side model keys live here, on
# Macham servers only. Merchants hold only their mch_ API key, never these.
GROQ_API_KEY=
# Groq model id. Verified 2026-10-03. Groq retires ids, re-verify on 4xx.
GROQ_MODEL=qwen/qwen3.8-27b
DEEPSEEK_API_KEY=
# Merchant key used by the snippet and SDK (dashboard-issued, publishable).
MACHAM_API_KEY=

# PayPal Orders v2. Both credentials are required for /v1/orders; without them
# the orders routes fail closed with 503. Never expose these to the browser.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Comma-separated origins allowed to call the gateway from a browser.
ASSIST_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Shop-any-store catalog lanes for /v1/catalog/resolve, tried in order:
#   1. UniversalAdapter — the store's own public endpoints (keyless, always on)
#   2. Kernel — a read-only cloud browser for client-hydrated JSON-LD (optional)
#   3. Channel3 — a paid product graph, also the only lane for free-text search (optional)
# Without a key its lane is skipped; search-only requests need CHANNEL3_API_KEY.
# All server-side only — never expose these to the browser.
KERNEL_API_KEY=
CHANNEL3_API_KEY=

# Optional semantic lane over the merchant's OWN indexed catalog. Fully inert
# unless BOTH are set; then /v1/catalog/resolve free-text queries hit Elastic
# first, then fall back to Channel3. See elastic/docker-compose.yml to self-host.
# Never expose the Elastic key to the browser — server-side only.
ELASTIC_URL=
ELASTIC_KEY=
